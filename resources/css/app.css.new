@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
    :root {
        --color-primary: #2563eb;
        --color-primary-hover: #1d4ed8;
        --color-secondary: #4b5563;
        --color-secondary-hover: #374151;
        --color-success: #16a34a;
        --color-danger: #dc2626;
        --color-warning: #ca8a04;
        --color-info: #2563eb;
    }

    html {
        @apply antialiased;
    }

    body {
        @apply text-gray-900 bg-gray-50;
        font-family: "Rubik", sans-serif;
    }

    h1 {
        @apply text-3xl font-bold sm:text-4xl;
    }

    h2 {
        @apply text-2xl font-bold sm:text-3xl;
    }

    h3 {
        @apply text-xl font-bold sm:text-2xl;
    }

    h4 {
        @apply text-lg font-bold;
    }
}

@layer components {
    .page-container {
        @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8;
    }

    .section {
        @apply py-8 sm:py-12;
    }

    .grid-list {
        @apply grid gap-6 sm:grid-cols-2 lg:grid-cols-3;
    }

    /* Form Components */
    .form-group {
        @apply space-y-4;
    }

    .form-label {
        @apply block text-sm font-medium text-gray-700 mb-1;
    }

    .form-input {
        @apply w-full rounded-lg border-gray-300 shadow-sm;
        @apply focus:border-primary focus:ring-1 focus:ring-primary;
    }

    .form-error {
        @apply mt-1 text-sm text-danger;
    }

    /* Book Card */
    .book-card {
        @apply flex flex-col bg-white rounded-lg shadow-sm transition duration-200;
        @apply hover:shadow-md;
    }

    .book-card-image {
        @apply aspect-[3/4] w-full rounded-t-lg object-cover;
    }

    .book-card-content {
        @apply p-4 flex flex-col flex-1;
    }

    .book-card-title {
        @apply text-lg font-semibold text-gray-900 mb-1 transition-colors;
        @apply hover:text-primary;
    }

    .book-card-author {
        @apply text-sm text-gray-600 mb-2;
    }

    /* Navigation */
    .nav-link {
        @apply flex items-center px-4 py-2 text-sm font-medium rounded-lg transition-colors;
    }

    .nav-link-active {
        @apply bg-primary/10 text-primary;
    }

    .nav-link-inactive {
        @apply text-gray-600;
        @apply hover:bg-primary/5;
    }

    /* Button Variants */
    .btn {
        @apply inline-flex items-center justify-center px-4 py-2 rounded-lg transition-colors;
        @apply text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2;
    }

    .btn-primary {
        @apply bg-primary text-white;
        @apply hover:bg-primary-hover focus:ring-primary/50;
    }

    .btn-secondary {
        @apply bg-secondary text-white;
        @apply hover:bg-secondary-hover focus:ring-secondary/50;
    }

    .btn-danger {
        @apply bg-danger text-white;
        @apply hover:bg-red-700 focus:ring-danger/50;
    }
}

@layer utilities {
    .flex-center {
        @apply flex items-center justify-center;
    }

    .absolute-center {
        @apply absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2;
    }
}